diff --git a/rvt/slurm_cluster_rvt2_full.sh b/rvt/slurm_cluster_rvt2_full.sh
new file mode 100755
index 0000000..f9317fb
--- /dev/null
+++ b/rvt/slurm_cluster_rvt2_full.sh
@@ -0,0 +1,63 @@
+#!/usr/bin/env bash
+#SBATCH --job-name=rvt2-full
+#SBATCH --time=7-00:00:00
+#SBATCH --open-mode=append
+#SBATCH --output=/data/xzha593/dataset/run/cluster_rvt2_full/slurm-%j.out
+#SBATCH --error=/data/xzha593/dataset/run/cluster_rvt2_full/slurm-%j.err
+#SBATCH --cpus-per-task=16
+#SBATCH --mem=16G
+#SBATCH --gres=gpu:a100:1
+
+set -euo pipefail
+
+PROJECT_ROOT=/data/xzha593/project/rvt-3d-policy-head-adaption/rvt
+RUN_DIR=/data/xzha593/dataset/run/cluster_rvt2_full
+ENV_ROOT=/data/xzha593/miniconda3/envs/rvt
+COPPELIASIM_ROOT=/data/xzha593/software/CoppeliaSim_Edu_V4_1_0_Ubuntu18_04
+
+mkdir -p "${RUN_DIR}" /data/xzha593/tmp
+
+export HOME=/data/xzha593
+export TMPDIR=/data/xzha593/tmp
+export CONDA_PREFIX="${ENV_ROOT}"
+export CUDA_HOME="${ENV_ROOT}"
+export COPPELIASIM_ROOT
+export PATH="${ENV_ROOT}/bin:/usr/local/bin:/usr/bin:/bin"
+export LD_LIBRARY_PATH="${ENV_ROOT}/lib:${COPPELIASIM_ROOT}:${LD_LIBRARY_PATH:-}"
+export QT_QPA_PLATFORM_PLUGIN_PATH="${COPPELIASIM_ROOT}"
+export PYTHONUNBUFFERED=1
+export OMP_NUM_THREADS=1
+export MKL_NUM_THREADS=1
+export OPENBLAS_NUM_THREADS=1
+export NUMEXPR_NUM_THREADS=1
+
+cd "${PROJECT_ROOT}"
+
+echo "Job ID: ${SLURM_JOB_ID}"
+echo "Host: $(hostname)"
+echo "Started: $(date --iso-8601=seconds)"
+echo "CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-}"
+echo "Python: $(command -v python)"
+python --version
+nvidia-smi
+
+RESUME_ARGS=()
+if [[ -f "${RUN_DIR}/model_last.pth" ]]; then
+  echo "Resuming from ${RUN_DIR}/model_last.pth"
+  RESUME_ARGS=(--exp_cfg_opts "resume ${RUN_DIR}/model_last.pth")
+else
+  echo "Starting from the configured pretrained backbone"
+fi
+
+set +e
+python train.py \
+  --exp_cfg_path configs/cluster_rvt2_full.yaml \
+  --mvt_cfg_path mvt/configs/rvt2.yaml \
+  --device 0 \
+  "${RESUME_ARGS[@]}"
+status=$?
+set -e
+
+echo "Finished: $(date --iso-8601=seconds)"
+echo "Exit status: ${status}"
+exit "${status}"
